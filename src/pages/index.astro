---
import Layout from '../layouts/Layout.astro';

const overviewServices = [
  { title: "Powder Coating Piece Work", desc: "High quality powder coating for durable and attractive finish.", img: "https://images.unsplash.com/photo-1620912189861-e7f0a5b0b0f5?auto=format&fit=crop&w=400&q=80" },
  { title: "Welding Piece Work", desc: "All types of welding solutions with strength and precision.", img: "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=400&q=80" },
  { title: "Bending Piece Work", desc: "Precision bending for all types of metal components.", img: "https://images.unsplash.com/photo-1565043666747-69f6646db940?auto=format&fit=crop&w=400&q=80" },
  { title: "Manpower Supply", desc: "Skilled, semi-skilled & unskilled manpower for all industries.", img: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=400&q=80" },
  { title: "Security Staff Supply", desc: "Trained and verified security staff for all your safety needs.", img: "https://images.unsplash.com/photo-1580795479225-c50ab8c3348d?auto=format&fit=crop&w=400&q=80" },
];

const whyPartner = [
  { title: "Quality Assurance", desc: "We maintain strict quality control at every step.", icon: "🛡️" },
  { title: "On-Time Delivery", desc: "We value time and ensure timely project completion.", icon: "⏱️" },
  { title: "Cost Effective", desc: "Competitive pricing with best industry standards.", icon: "💰" },
  { title: "Expert Team", desc: "Experienced professionals and skilled workforce.", icon: "🎓" },
  { title: "Customer Satisfaction", desc: "Client satisfaction is our top priority.", icon: "⭐" },
];

const industries = [
  { name: "Automotive", icon: "🚗" },
  { name: "Construction", icon: "🏗️" },
  { name: "Fabrication", icon: "🔧" },
  { name: "Engineering", icon: "⚙️" },
  { name: "Electrical", icon: "🔌" },
  { name: "Infrastructure", icon: "🏢" },
  { name: "Logistics", icon: "🚚" },
  { name: "Manufacturing", icon: "🏭" },
];

const gallery = [
  "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=500&q=80",
  "https://images.unsplash.com/photo-1620912189861-e7f0a5b0b0f5?auto=format&fit=crop&w=500&q=80",
  "https://images.unsplash.com/photo-1565043666747-69f6646db940?auto=format&fit=crop&w=500&q=80",
  "https://images.unsplash.com/photo-1581092160607-ee22731c9c62?auto=format&fit=crop&w=500&q=80",
  "https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=500&q=80",
];
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="relative bg-slate-950 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 lg:py-24 grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div class="text-center lg:text-left">
        <p class="text-orange-500 font-bold tracking-[0.2em] text-xs sm:text-sm mb-3">PRECISION WORK. TRUSTED PEOPLE.</p>
        <h1 class="text-3xl sm:text-5xl lg:text-[3.4rem] font-black text-white leading-tight mb-4 sm:mb-6">
          MECHANICAL PIECE WORK <span class="text-orange-500">&amp; HUMAN RESOURCE</span> SOLUTIONS
        </h1>
        <p class="text-slate-400 text-sm sm:text-lg mb-6 sm:mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
          Delivering high-quality mechanical piece work and reliable manpower &amp; security solutions to power your business forward.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start mb-8 sm:mb-10">
          <a href="/services" class="w-full sm:w-auto bg-orange-500 hover:bg-orange-600 text-white font-bold px-6 py-3 rounded text-center transition-all">Our Services</a>
          <a href="/contact" class="w-full sm:w-auto border border-slate-700 hover:border-orange-500 text-white font-semibold px-6 py-3 rounded text-center transition-all">Talk to Expert →</a>
        </div>
        <div class="grid grid-cols-4 gap-4 sm:gap-6 border-t border-slate-800 pt-6">
          <div><div class="text-lg sm:text-2xl font-extrabold text-orange-500">10+</div><div class="text-[10px] sm:text-xs text-slate-400 mt-1">Years Experience</div></div>
          <div><div class="text-lg sm:text-2xl font-extrabold text-orange-500">500+</div><div class="text-[10px] sm:text-xs text-slate-400 mt-1">Happy Clients</div></div>
          <div><div class="text-lg sm:text-2xl font-extrabold text-orange-500">1000+</div><div class="text-[10px] sm:text-xs text-slate-400 mt-1">Projects Completed</div></div>
          <div><div class="text-lg sm:text-2xl font-extrabold text-orange-500">50+</div><div class="text-[10px] sm:text-xs text-slate-400 mt-1">Skilled Employees</div></div>
        </div>
      </div>
      <div class="rounded-xl sm:rounded-2xl overflow-hidden border border-slate-800 shadow-2xl mt-6 lg:mt-0">
        <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=1000&q=80" alt="Industrial Welding Work" class="w-full h-64 sm:h-96 lg:h-[480px] object-cover" />
      </div>
    </div>
  </section>

  <!-- Main Categories -->
  <section class="py-12 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-4 mb-8 sm:mb-12">
        <span class="h-px w-10 bg-orange-500"></span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-wide">OUR MAIN CATEGORIES</h2>
        <span class="h-px w-10 bg-orange-500"></span>
      </div>
      <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
        <div class="relative bg-slate-950 p-6 sm:p-10 rounded-xl overflow-hidden bg-cover bg-center" style="background-image:linear-gradient(rgba(2,6,23,.85),rgba(2,6,23,.85)), url('https://images.unsplash.com/photo-1565043666747-69f6646db940?auto=format&fit=crop&w=800&q=80')">
          <span class="text-3xl">⚙️</span>
          <h3 class="text-xl sm:text-2xl font-bold text-white mt-4 mb-3">MECHANICAL PIECE WORK</h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">Precision engineering services with advanced technology and skilled professionals.</p>
          <a href="/services" class="inline-block border border-white/40 text-white font-semibold px-5 py-2 rounded hover:bg-white hover:text-slate-950 transition-all text-sm">Explore Services →</a>
        </div>
        <div class="relative p-6 sm:p-10 rounded-xl overflow-hidden bg-cover bg-center" style="background-image:linear-gradient(rgba(217,119,6,.88),rgba(217,119,6,.88)), url('https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=800&q=80')">
          <span class="text-3xl">👷</span>
          <h3 class="text-xl sm:text-2xl font-bold text-white mt-4 mb-3">HUMAN RESOURCE MANAGEMENT</h3>
          <p class="text-orange-50 text-sm sm:text-base leading-relaxed mb-6">Manpower supply and security staff solutions tailored to your business requirements.</p>
          <a href="/services" class="inline-block border border-white/60 text-white font-semibold px-5 py-2 rounded hover:bg-white hover:text-orange-600 transition-all text-sm">Explore Services →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-12 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-4 mb-8 sm:mb-12">
        <span class="h-px w-10 bg-orange-500"></span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-wide">OUR SERVICES OVERVIEW</h2>
        <span class="h-px w-10 bg-orange-500"></span>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5 sm:gap-6">
        {overviewServices.map((s) => (
          <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-slate-100 hover:shadow-lg transition-all">
            <img src={s.img} alt={s.title} class="w-full h-36 object-cover" />
            <div class="p-4 sm:p-5">
              <h3 class="font-bold text-slate-900 text-sm sm:text-base mb-2">{s.title}</h3>
              <p class="text-slate-500 text-xs sm:text-sm leading-relaxed mb-3">{s.desc}</p>
              <a href="/services" class="text-orange-500 font-semibold text-xs sm:text-sm hover:underline">Learn More →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Partner -->
  <section class="py-12 sm:py-20 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl sm:text-2xl font-extrabold text-white text-center tracking-wide mb-10 sm:mb-14">WHY PARTNER WITH MECHWORK SOLUTIONS?</h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8 sm:gap-6 text-center">
        {whyPartner.map((w) => (
          <div>
            <div class="w-14 h-14 mx-auto mb-4 rounded-full border border-orange-500/40 flex items-center justify-center text-2xl">{w.icon}</div>
            <h3 class="text-orange-500 font-bold text-sm sm:text-base mb-2">{w.title.toUpperCase()}</h3>
            <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Committed to Precision Banner -->
  <section class="bg-orange-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 grid lg:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight mb-3">COMMITTED TO PRECISION.<br />FOCUSED ON <span class="text-slate-950">PERFORMANCE.</span></h2>
        <p class="text-orange-50 text-sm sm:text-base max-w-lg mb-6">From single components to bulk orders, from skilled manpower to round-the-clock security — we deliver solutions you can rely on.</p>
        <a href="/about" class="inline-block bg-slate-950 hover:bg-slate-800 text-white font-bold px-6 py-3 rounded transition-all text-sm">Know More About Us</a>
      </div>
      <div class="grid grid-cols-4 gap-4 sm:gap-6 text-center">
        <div><div class="text-2xl sm:text-4xl font-extrabold text-white">10+</div><div class="text-[10px] sm:text-xs text-orange-100 mt-1">Years Experience</div></div>
        <div><div class="text-2xl sm:text-4xl font-extrabold text-white">500+</div><div class="text-[10px] sm:text-xs text-orange-100 mt-1">Happy Clients</div></div>
        <div><div class="text-2xl sm:text-4xl font-extrabold text-white">1000+</div><div class="text-[10px] sm:text-xs text-orange-100 mt-1">Projects Completed</div></div>
        <div><div class="text-2xl sm:text-4xl font-extrabold text-white">50+</div><div class="text-[10px] sm:text-xs text-orange-100 mt-1">Skilled Employees</div></div>
      </div>
    </div>
  </section>

  <!-- Industries We Serve -->
  <section id="industries" class="py-12 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-4 mb-8 sm:mb-12">
        <span class="h-px w-10 bg-orange-500"></span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-wide">INDUSTRIES WE SERVE</h2>
        <span class="h-px w-10 bg-orange-500"></span>
      </div>
      <div class="grid grid-cols-4 md:grid-cols-8 gap-4 sm:gap-6">
        {industries.map((ind) => (
          <div class="flex flex-col items-center text-center p-3 sm:p-4 rounded-xl border border-slate-100 hover:border-orange-500 hover:shadow-md transition-all">
            <span class="text-2xl sm:text-3xl mb-2">{ind.icon}</span>
            <span class="text-[11px] sm:text-xs font-semibold text-slate-700">{ind.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Work Gallery -->
  <section id="gallery" class="py-12 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-4 mb-8 sm:mb-12">
        <span class="h-px w-10 bg-orange-500"></span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-wide">OUR WORK GALLERY</h2>
        <span class="h-px w-10 bg-orange-500"></span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3 sm:gap-4 mb-8">
        {gallery.map((g) => (
          <div class="rounded-lg overflow-hidden">
            <img src={g} alt="Work gallery" class="w-full h-28 sm:h-40 object-cover hover:scale-105 transition-transform duration-300" />
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href="/services" class="inline-block border border-slate-300 hover:border-orange-500 hover:text-orange-500 text-slate-700 font-semibold px-6 py-3 rounded transition-all text-sm">View Full Gallery</a>
      </div>
    </div>
  </section>

  <!-- Testimonials & Certifications -->
  <section class="py-12 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8">
      <div class="bg-slate-50 rounded-xl p-6 sm:p-10 border border-slate-100">
        <span class="text-4xl text-orange-500">&ldquo;</span>
        <h3 class="font-bold text-slate-900 mb-3">WHAT OUR CLIENTS SAY</h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-4">Mechwork Solutions has been a valuable partner in our growth journey. Their quality of work, commitment, and workforce support is outstanding.</p>
        <p class="font-semibold text-slate-900 text-sm">— Rakesh Sharma</p>
        <p class="text-slate-400 text-xs">Production Head, ARC Engineering</p>
        <div class="flex gap-2 mt-6">
          <span class="w-2 h-2 rounded-full bg-orange-500"></span>
          <span class="w-2 h-2 rounded-full bg-slate-300"></span>
          <span class="w-2 h-2 rounded-full bg-slate-300"></span>
        </div>
      </div>
      <div class="bg-slate-50 rounded-xl p-6 sm:p-10 border border-slate-100 flex flex-col justify-center">
        <h3 class="font-bold text-slate-900 mb-6 text-center">CERTIFICATIONS &amp; COMPLIANCE</h3>
        <div class="flex items-center justify-center gap-8 text-3xl text-slate-500">
          <span title="ISO 9001:2015">🏅</span>
          <span title="CE">CE</span>
          <span title="Compliant">✅</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="text-center sm:text-left">
        <h2 class="text-xl sm:text-2xl font-extrabold text-white mb-2">READY TO START YOUR NEXT PROJECT?</h2>
        <p class="text-slate-400 text-sm sm:text-base">Get in touch with us today. We are ready to deliver the right solution for your business.</p>
      </div>
      <a href="/contact" class="whitespace-nowrap bg-orange-500 hover:bg-orange-600 text-white font-bold px-6 py-3 rounded transition-all text-sm">Get a Free Quote</a>
    </div>
  </section>
</Layout>
