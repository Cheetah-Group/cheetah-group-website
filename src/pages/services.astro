---
import Layout from '../layouts/Layout.astro';

const mechanicalServices = [
  { title: "Powder Coating Piece Work", desc: "We provide premium quality powder coating services for a long-lasting, corrosion resistant and attractive finish.", items: ["Pre-treatment", "Powder Coating", "Curing", "Quality Inspection"], img: "https://images.unsplash.com/photo-1620912189861-e7f0a5b0b0f5?auto=format&fit=crop&w=500&q=80", icon: "🎨" },
  { title: "Welding Piece Work", desc: "Expert in all types of welding processes ensuring strong, precise and durable joints.", items: ["MIG Welding", "TIG Welding", "Spot Welding", "Arc Welding"], img: "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=500&q=80", icon: "🔥" },
  { title: "Bending Piece Work", desc: "CNC and V-Bending services for MS, SS, Aluminum and GI sheets & pipes with high accuracy.", items: ["CNC Bending", "Press Brake Bending", "Rolling", "Fabrication Support"], img: "https://images.unsplash.com/photo-1565043666747-69f6646db940?auto=format&fit=crop&w=500&q=80", icon: "📐" },
];

const hrServices = [
  { title: "Manpower Supply", desc: "We supply skilled, semi-skilled and unskilled manpower for various industrial operations.", items: ["Skilled Manpower", "Semi-skilled Manpower", "Unskilled Manpower", "Contract / Temporary Staffing"], img: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=700&q=80" },
  { title: "Security Staff Supply", desc: "Professional and well-trained security staff to ensure safety and peace of mind.", items: ["Security Guards", "Supervisors", "CCTV Monitoring Staff", "24x7 Security Support"], img: "https://images.unsplash.com/photo-1580795479225-c50ab8c3348d?auto=format&fit=crop&w=700&q=80" },
];
---

<Layout title="Our Services">
  <!-- Page Header -->
  <section class="relative bg-slate-950 py-16 sm:py-20 text-center overflow-hidden">
    <div class="absolute inset-0 opacity-30 bg-cover bg-center" style="background-image:url('https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=1400&q=80')"></div>
    <div class="relative">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-wide">OUR SERVICES</h1>
      <p class="text-slate-400 mt-3 text-sm"><a href="/" class="hover:text-orange-500">Home</a> &gt; Services</p>
    </div>
  </section>

  <!-- Mechanical Piece Work Services -->
  <section class="py-14 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-wide text-center mb-10 sm:mb-12">MECHANICAL PIECE WORK SERVICES</h2>
    <div class="grid md:grid-cols-3 gap-6 sm:gap-8">
      {mechanicalServices.map((service) => (
        <div class="bg-white border border-slate-100 rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-all">
          <img src={service.img} alt={service.title} class="w-full h-44 object-cover" />
          <div class="p-6 relative">
            <div class="absolute -top-6 left-6 w-11 h-11 rounded-full bg-slate-950 text-orange-500 flex items-center justify-center text-lg border-4 border-white">{service.icon}</div>
            <h3 class="text-lg font-bold text-slate-900 mt-4 mb-2">{service.title.toUpperCase()}</h3>
            <p class="text-slate-500 text-sm mb-4 leading-relaxed">{service.desc}</p>
            <ul class="space-y-2 text-sm text-slate-600">
              {service.items.map((item) => <li class="flex items-center gap-2"><span class="text-orange-500 font-bold">•</span> {item}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- HR Management Services -->
  <section class="pb-14 sm:pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-wide text-center mb-10 sm:mb-12">HUMAN RESOURCE MANAGEMENT SERVICES</h2>
    <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
      {hrServices.map((service) => (
        <div class="relative rounded-xl overflow-hidden h-64 sm:h-72 bg-cover bg-center shadow-sm" style={`background-image:linear-gradient(rgba(2,6,23,.75),rgba(2,6,23,.88)), url('${service.img}')`}>
          <div class="relative h-full flex flex-col justify-end p-6 sm:p-8">
            <h3 class="text-xl font-bold text-white mb-2">{service.title.toUpperCase()}</h3>
            <p class="text-slate-300 text-sm mb-4 leading-relaxed max-w-md">{service.desc}</p>
            <ul class="grid grid-cols-2 gap-y-1 gap-x-4 text-sm text-slate-200">
              {service.items.map((item) => <li class="flex items-center gap-2"><span class="text-orange-500 font-bold">•</span> {item}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Custom Solution CTA -->
  <section class="bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4 text-center sm:text-left">
        <span class="text-3xl hidden sm:block">⚙️</span>
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-white">Looking for a Custom Solution?</h2>
          <p class="text-slate-400 text-sm">We understand your requirement and deliver tailored solutions.</p>
        </div>
      </div>
      <a href="/contact" class="whitespace-nowrap bg-orange-500 hover:bg-orange-600 text-white font-bold px-6 py-3 rounded transition-all text-sm">Get a Quote</a>
    </div>
  </section>
</Layout>
