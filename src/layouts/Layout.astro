---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Mechwork Solutions - Mechanical Piece Work & Human Resource Solutions" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Cheetah Solutions</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-white text-slate-800 font-sans antialiased flex flex-col min-h-screen">
    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 bg-white border-b border-slate-100 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 sm:gap-3">
          <span class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 bg-orange-500 text-slate-950 rounded-md font-black text-sm sm:text-base">CS</span>
          <span class="leading-tight">
            <span class="block text-sm sm:text-base font-extrabold tracking-wide text-slate-900">Cheetah</span>
            <span class="block text-[10px] sm:text-xs font-semibold tracking-[0.2em] text-orange-500 -mt-0.5">SOLUTIONS</span>
          </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-sm font-semibold text-slate-600">
          <a href="/" class="hover:text-orange-500 transition-colors">Home</a>
          <a href="/services" class="hover:text-orange-500 transition-colors">Services</a>
          <a href="/about" class="hover:text-orange-500 transition-colors">About Us</a>
          <a href="/contact" class="hover:text-orange-500 transition-colors">Contact Us</a>
        </nav>

        <div class="hidden lg:block">
          <a href="/contact" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-5 py-2.5 rounded transition-all text-sm shadow-sm">
            Get a Quote
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" aria-label="Toggle Navigation" class="lg:hidden p-2 text-slate-700 hover:text-orange-500 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown Navigation -->
      <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-100 px-4 pt-2 pb-6 space-y-3">
        <a href="/" class="block py-2 text-slate-600 hover:text-orange-500 font-semibold">Home</a>
        <a href="/services" class="block py-2 text-slate-600 hover:text-orange-500 font-semibold">Services</a>
        <a href="/about" class="block py-2 text-slate-600 hover:text-orange-500 font-semibold">About Us</a>
        <a href="/contact" class="block py-2 text-slate-600 hover:text-orange-500 font-semibold">Contact Us</a>
        <a href="/contact" class="block w-full text-center bg-orange-500 text-white font-bold py-2.5 rounded mt-4">
          Get a Quote
        </a>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-slate-950 pt-12 sm:pt-16 pb-6 text-slate-400 text-xs sm:text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10 mb-10">
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="flex items-center justify-center w-8 h-8 bg-orange-500 text-slate-950 rounded font-black text-sm">CS</span>
            <span class="text-sm font-extrabold tracking-wide text-white">Cheetah <span class="text-orange-500">SOLUTIONS</span></span>
          </div>
          <p class="leading-relaxed">Precision people, powerful results — delivering high-quality mechanical piece work and reliable manpower &amp; security solutions to power your business forward.</p>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-3 sm:mb-4">Quick Links</h4>
          <ul class="space-y-2">
            <li><a href="/" class="hover:text-orange-500">Home</a></li>
            <li><a href="/services" class="hover:text-orange-500">Services</a></li>
            <li><a href="/about" class="hover:text-orange-500">About Us</a></li>            <li><a href="/contact" class="hover:text-orange-500">Contact Us</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-3 sm:mb-4">Our Services</h4>
          <ul class="space-y-2">
            <li><a href="/services" class="hover:text-orange-500">Powder Coating Piece Work</a></li>
            <li><a href="/services" class="hover:text-orange-500">Welding Piece Work</a></li>
            <li><a href="/services" class="hover:text-orange-500">Bending Piece Work</a></li>
            <li><a href="/services" class="hover:text-orange-500">Manpower Supply</a></li>
            <li><a href="/services" class="hover:text-orange-500">Security Staff Supply</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-3 sm:mb-4">Contact Info</h4>
          <p class="mb-2">📞 +91 12345 67890</p>
          <p class="mb-2">✉️ info@mechworksolutions.com</p>
          <p class="mb-2">📍 123, Industrial Area, City, State - 000000</p>
          <div class="flex gap-3 mt-4">
            <a href="#" aria-label="Facebook" class="w-8 h-8 rounded-full border border-slate-700 flex items-center justify-center hover:border-orange-500 hover:text-orange-500">f</a>
            <a href="#" aria-label="LinkedIn" class="w-8 h-8 rounded-full border border-slate-700 flex items-center justify-center hover:border-orange-500 hover:text-orange-500">in</a>
            <a href="#" aria-label="Instagram" class="w-8 h-8 rounded-full border border-slate-700 flex items-center justify-center hover:border-orange-500 hover:text-orange-500">ig</a>
          </div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-2 text-center text-xs">
        <p>© 2026 Cheetah Solutions. All Rights Reserved.</p>
        <div class="flex gap-4">
          <a href="#" class="hover:text-orange-500">Privacy Policy</a>
          <a href="#" class="hover:text-orange-500">Terms &amp; Conditions</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');

      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
